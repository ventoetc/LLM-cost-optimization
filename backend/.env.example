# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Direct provider keys for fallback
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./llm_optimizer.db

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Application
APP_NAME=LLM Cost Optimizer
DEBUG=true
LOG_LEVEL=info

# Model Configuration
DECOMPOSER_MODEL=anthropic/claude-3-haiku
BASELINE_MODEL=anthropic/claude-opus-4-5
DEFAULT_ROUTER_STRATEGY=learning
